---
import { STORY_TEXT_FIELDS } from '../lib/picturebook-story.mjs';
import { STORY_STARTS, STORY_START_ORDER } from '../lib/picturebook-prompts.mjs';

const starts = STORY_START_ORDER.map((id) => STORY_STARTS[id]);
---

<section class="pb-section pb-story" data-story-card aria-labelledby="story-card-title">
  <div class="pb-section-heading">
    <p class="pb-kicker">step 01 / find your idea</p>
    <h2 id="story-card-title">你想创造一个什么样的故事？</h2>
    <p>不用想得太复杂。选一个喜欢的起点，也可以完全自己创造。你负责想象和决定，AI 是你的创作搭档。</p>
  </div>

  <fieldset class="pb-start-picker">
    <legend>你的故事，想从哪里开始？</legend>
    {starts.map((start, index) => (
      <label class="pb-start-option">
        <input type="radio" name="storyStart" value={start.id} checked={index === 0} data-story-start />
        <span>{start.label}</span>
        <small>{start.prompt}</small>
      </label>
    ))}
  </fieldset>

  <div class="pb-seed-panel">
    <label class="pb-answer-field">
      <span data-seed-label>{starts[0].label}：挑一个灵感，或者写你自己的</span>
      <textarea rows="3" maxlength="240" data-story-seed placeholder={starts[0].placeholder}></textarea>
    </label>
    <div class="pb-inspiration" data-story-inspiration>
      <p class="pb-inspiration-label">没有头绪？点一个当起点，再改成你自己的版本。</p>
      <div class="pb-inspiration-list" data-story-inspiration-list></div>
    </div>
    <p class="pb-feedback" data-seed-feedback role="status"></p>
  </div>

  <div class="pb-copy-panel pb-copy-panel--prompt">
    <div>
      <p class="pb-kicker">step 02 / create your prompt</p>
      <h3>为你的故事生成采访提示词</h3>
      <p>复制后粘到老师指定的课堂智能体里。它会一次只问一个问题，帮你想清楚；信息够了就写完整故事，再请你检查。</p>
    </div>
    <div class="pb-inline-actions">
      <button class="pb-button pb-button--secondary" type="button" data-generate-socratic>生成提示词</button>
      <button class="pb-button pb-button--quiet" type="button" data-copy-socratic hidden>复制提示词</button>
    </div>
    <pre class="pb-output" data-socratic-output hidden tabindex="0"></pre>
    <p class="pb-feedback" data-socratic-feedback role="status"></p>
  </div>

  <div class="pb-story-return">
    <div class="pb-section-heading">
      <p class="pb-kicker">step 03 / story interview</p>
      <h2>去和 AI 故事导演聊一聊。</h2>
      <p>你是故事导演，AI 是你的采访搭档。一次回答一个问题，想到什么就大胆说；不满意就继续讨论，直到你认可创意和故事。</p>
    </div>
    <ol class="pb-agent-steps">
      <li><strong>复制提示词</strong><span>把刚才生成的专属提示词复制下来。</span></li>
      <li><strong>打开课堂 Agent</strong><span>进入老师指定的 AI 智能体。</span></li>
      <li><strong>开始故事采访</strong><span>一次回答一个问题，想到什么就大胆说。</span></li>
      <li><strong>确认你的故事</strong><span>创意卡和完整故事都认可后，再带回网站。</span></li>
    </ol>
  </div>

  <div class="pb-story-return">
    <div class="pb-section-heading">
      <p class="pb-kicker">step 04 / save your story</p>
      <h2>把你的故事带回家。</h2>
      <p>把智能体整理好的故事创意卡和完整故事粘贴到下面。检查后就能保存你的原创作品。</p>
    </div>

    <div class="pb-story-progress">
      <span data-story-progress>故事档案 0 / 2</span>
      <div class="pb-progress-track" aria-hidden="true"><span data-story-bar></span></div>
    </div>

    <div class="pb-story-text-fields">
      {STORY_TEXT_FIELDS.map((field) => (
        <label class:list={['pb-answer-field', { 'pb-answer-field--wide': field.rows > 6 }]}>
          <span>{field.label}{field.required ? <em class="pb-required">必填</em> : <em class="pb-optional">选填</em>}</span>
          <small class="pb-field-hint">{field.hint}</small>
          <textarea rows={field.rows} maxlength={field.id === 'storyBody' ? 4000 : 1200} data-story-text={field.id} placeholder={field.placeholder}></textarea>
        </label>
      ))}
    </div>

    <p class="pb-story-note">先在智能体里把创意卡和最终故事都确认好，再复制回来。故事必须经过你的检查和认可。</p>
  </div>
</section>

<script>
  // @ts-nocheck
  import { copyTextToClipboard } from '../lib/ai-planet-builder.mjs';
  import { STORY_STARTS, buildSocraticPrompt } from '../lib/picturebook-prompts.mjs';
  import { STORY_REQUIRED_TEXT_FIELDS, STORY_TEXT_FIELDS, storyCompletion } from '../lib/picturebook-story.mjs';
  import { saveStoryText, setSeed, setStart, workspace } from '../lib/picturebook-workspace.mjs';

  const root = document.querySelector('[data-story-card]');

  if (root) {
    const seedField = root.querySelector('[data-story-seed]');
    const seedLabel = root.querySelector('[data-seed-label]');
    const seedFeedback = root.querySelector('[data-seed-feedback]');
    const inspirationBox = root.querySelector('[data-story-inspiration]');
    const inspirationList = root.querySelector('[data-story-inspiration-list]');
    const progressText = root.querySelector('[data-story-progress]');
    const progressBar = root.querySelector('[data-story-bar]');
    const socraticOutput = root.querySelector('[data-socratic-output]');
    const socraticFeedback = root.querySelector('[data-socratic-feedback]');
    const copySocratic = root.querySelector('[data-copy-socratic]');

    const renderSeed = () => {
      const start = STORY_STARTS[workspace.start] || STORY_STARTS.character;
      if (seedLabel) seedLabel.textContent = `${start.label}：挑一个灵感，或者写你自己的`;
      if (seedField && document.activeElement !== seedField) {
        seedField.value = workspace.seed;
        seedField.placeholder = start.placeholder;
      }
      if (inspirationList && inspirationBox) {
        inspirationList.replaceChildren();
        inspirationBox.hidden = false;
        start.ideas.forEach((idea) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'pb-choice-chip pb-choice-chip--idea';
          button.textContent = idea;
          button.addEventListener('click', () => {
            if (seedField) {
              seedField.value = idea;
              seedField.dispatchEvent(new Event('input', { bubbles: true }));
              seedField.focus();
            }
          });
          inspirationList.appendChild(button);
        });
      }
    };

    const renderTextFields = () => {
      const complete = storyCompletion(workspace.story);
      STORY_TEXT_FIELDS.forEach((field) => {
        const input = root.querySelector(`[data-story-text="${field.id}"]`);
        if (input && document.activeElement !== input) input.value = workspace.story.text[field.id] || '';
      });
      if (progressText) progressText.textContent = `故事档案 ${complete} / ${STORY_REQUIRED_TEXT_FIELDS.length}`;
      if (progressBar) progressBar.style.width = `${(complete / STORY_REQUIRED_TEXT_FIELDS.length) * 100}%`;
    };

    const renderAll = () => {
      renderSeed();
      renderTextFields();
    };

    root.querySelectorAll('[data-story-start]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          setStart(radio.value);
          renderSeed();
        }
      });
    });

    seedField?.addEventListener('input', () => {
      setSeed(seedField.value);
      if (seedFeedback) {
        seedFeedback.textContent = seedField.value.trim()
          ? '记住了。现在生成提示词，把这句话交给课堂智能体。'
          : '';
        seedFeedback.dataset.tone = seedField.value.trim() ? 'ok' : 'neutral';
      }
    });

    root.querySelectorAll('[data-story-text]').forEach((input) => {
      input.addEventListener('input', () => saveStoryText(input.dataset.storyText, input.value));
    });

    root.querySelector('[data-generate-socratic]')?.addEventListener('click', () => {
      const prompt = buildSocraticPrompt({
        story: {
          startKind: workspace.start,
          seed: workspace.seed,
        },
      });
      if (socraticOutput) {
        socraticOutput.textContent = prompt;
        socraticOutput.hidden = false;
      }
      if (copySocratic) copySocratic.hidden = false;
      if (socraticFeedback) {
        socraticFeedback.textContent = '提示词已生成。粘到课堂智能体里：先一次一问，确认创意卡，再写故事。';
      }
    });

    copySocratic?.addEventListener('click', async () => {
      const copied = await copyTextToClipboard(socraticOutput?.textContent || '');
      if (socraticFeedback) socraticFeedback.textContent = copied ? '已复制提示词。' : '复制没有成功，请手动选中文字。';
    });

    document.addEventListener('picturebook:workspace-change', renderAll);
    document.addEventListener('picturebook:project-imported', renderAll);
    renderAll();
  }
</script>
