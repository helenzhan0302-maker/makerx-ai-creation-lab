---
import {
  AVATAR_EFFECT_OPTIONS,
  CURSOR_EFFECT_OPTIONS,
  DEFAULT_AVATAR_EFFECTS,
  MAX_AVATAR_EFFECTS,
  PET_ACTION_OPTIONS,
  PET_TYPE_OPTIONS,
} from '../lib/planet-upgrade.mjs';

const avatarSrc = `${import.meta.env.BASE_URL}assets/avatar/particle-avatar.mavatar?v=2`;
---

<section class="upgrade-builder" id="upgrade-builder" aria-labelledby="upgrade-title">
  <div class="builder-heading">
    <p class="eyebrow">lesson 02 / upgrade workshop</p>
    <h2 id="upgrade-title">一步一步，把 AI星球升级成 2.0。</h2>
    <p>这些效果会写进一段中文提示词。你只要点选，不用打字。这里不会保存或上传你的内容，刷新后重新开始。</p>
  </div>

  <div class="builder-progress" aria-label="填写进度">
    <div class="builder-progress-track"><span data-progress-bar></span></div>
    <p><span data-progress-current>1</span> / 3　<span data-progress-label>头像升级</span></p>
  </div>

  <form data-upgrade-form novalidate>
    <div class="builder-panels">
      <section class="builder-step is-active" data-step-panel="0" aria-labelledby="upgrade-step-title-0">
        <div class="step-heading">
          <span class="step-number">01</span>
          <div>
            <p class="eyebrow">必做任务</p>
            <h3 id="upgrade-step-title-0">你想让头像怎么动？</h3>
          </div>
          <span class="selection-limit">最多选择 {MAX_AVATAR_EFFECTS} 个</span>
        </div>

        <div class="avatar-orbit">
          <div class="avatar-preview" data-avatar-preview>
            <div class="avatar-mesh-stage" data-avatar-mesh-stage>
              <mesh-avatar
                data-avatar-mesh
                src={avatarSrc}
                label="3D 珠子风互动头像"
                tabindex="0"
                fit="contain"></mesh-avatar>
              <p class="avatar-mesh-fallback" data-avatar-mesh-fallback hidden>这个浏览器暂时不能显示动态头像，但下面的效果选择仍然可以生成提示词。</p>
            </div>
            <div class="avatar-sparkles" aria-hidden="true">
              <span>✦</span><span>✦</span><span>✦</span><span>✦</span>
            </div>
            <div class="avatar-bubble-card" data-avatar-bubble-card aria-live="polite">
              <span class="avatar-bubble" data-avatar-bubble>嘿嘿，好痒～</span>
            </div>
          </div>

          <fieldset class="effect-orbit">
            <legend class="sr-only">选择头像效果，最多三个</legend>
            {AVATAR_EFFECT_OPTIONS.map((option, index) => (
              <label class={`effect-chip effect-chip--${index + 1}`}>
                <input
                  type="checkbox"
                  name="avatarEffects"
                  value={option.id}
                  checked={DEFAULT_AVATAR_EFFECTS.includes(option.id)}
                />
                <span class="effect-chip-mark" aria-hidden="true">✦</span>
                <span class="effect-chip-copy">
                  <span class="effect-chip-label">{option.label}</span>
                  <span class="effect-chip-description">{option.description}</span>
                </span>
              </label>
            ))}
          </fieldset>
        </div>
        <p class="avatar-preview-hint">在头像上移动鼠标看眼睛；点一下头像换表情。勾选「摸头有反应」后，移到头顶可以摸摸它。</p>
        <p class="builder-error" data-error-for="0" role="alert"></p>
      </section>

      <section class="builder-step" data-step-panel="1" aria-labelledby="upgrade-step-title-1" hidden>
        <div class="step-heading">
          <span class="step-number">02</span>
          <div>
            <p class="eyebrow">选做任务</p>
            <h3 id="upgrade-step-title-1">鼠标移动时，要不要留下一点魔法？</h3>
          </div>
        </div>

        <div class="upgrade-trail-stage">
          <div class="trail-preview" data-trail-preview aria-hidden="true">
            <canvas data-trail-canvas></canvas>
            <p class="trail-preview-label">在这个框里移动鼠标试试</p>
          </div>
          <fieldset class="choice-grid choice-grid--cursor-effects">
            <legend class="sr-only">选择一种鼠标特效</legend>
            {CURSOR_EFFECT_OPTIONS.map((option, index) => (
              <label class="choice-card choice-card--compact">
                <input type="radio" name="cursorEffect" value={option.id} checked={index === 0} />
                <span class="choice-card-mark" aria-hidden="true">✦</span>
                <span class="choice-card-label">{option.label}</span>
              </label>
            ))}
          </fieldset>
        </div>
        <p class="builder-error" data-error-for="1" role="alert"></p>
      </section>

      <section class="builder-step" data-step-panel="2" aria-labelledby="upgrade-step-title-2" hidden>
        <div class="step-heading">
          <span class="step-number">03</span>
          <div>
            <p class="eyebrow">挑战任务</p>
            <h3 id="upgrade-step-title-2">要不要养一只屏幕宠物？</h3>
          </div>
        </div>

        <div class="upgrade-pet-stage">
          <div class="pet-diorama" data-pet-preview>
            <div class="pet-diorama-scene">
              <div class="pet-lamp-glow" aria-hidden="true"></div>
              <div class="pet-island" aria-hidden="true">
                <div class="pet-island-top"></div>
                <div class="pet-island-body"></div>
              </div>
              <div class="pet-figure" data-pet-avatar>
                <svg viewBox="0 0 140 130" role="img" aria-label="微缩立体场景里的屏幕宠物">
                  <defs>
                    <linearGradient id="pet-metal" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#f6fbff" />
                      <stop offset="55%" stop-color="#c3d9ec" />
                      <stop offset="100%" stop-color="#7d95ad" />
                    </linearGradient>
                    <linearGradient id="pet-metal-warm" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#ffe9c9" />
                      <stop offset="60%" stop-color="#e9b98a" />
                      <stop offset="100%" stop-color="#b57f55" />
                    </linearGradient>
                    <linearGradient id="pet-fur-orange" x1="20%" y1="0%" x2="80%" y2="100%">
                      <stop offset="0%" stop-color="#ffd39a" />
                      <stop offset="52%" stop-color="#ff9a52" />
                      <stop offset="100%" stop-color="#d1602a" />
                    </linearGradient>
                    <linearGradient id="pet-fur-cream" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#fff6e8" />
                      <stop offset="100%" stop-color="#f3cfae" />
                    </linearGradient>
                    <linearGradient id="pet-scale" x1="15%" y1="0%" x2="85%" y2="100%">
                      <stop offset="0%" stop-color="#b8f5b0" />
                      <stop offset="50%" stop-color="#5fd07d" />
                      <stop offset="100%" stop-color="#2b7f4c" />
                    </linearGradient>
                    <linearGradient id="pet-grape" x1="15%" y1="0%" x2="85%" y2="100%">
                      <stop offset="0%" stop-color="#e2cbff" />
                      <stop offset="50%" stop-color="#a97cf0" />
                      <stop offset="100%" stop-color="#5c3a9e" />
                    </linearGradient>
                    <linearGradient id="pet-lens" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#a8fff2" />
                      <stop offset="55%" stop-color="#38d9d0" />
                      <stop offset="100%" stop-color="#0d6f86" />
                    </linearGradient>
                    <filter id="pet-soft-shadow" x="-40%" y="-40%" width="180%" height="180%">
                      <feDropShadow dx="0" dy="2.6" stdDeviation="2.2" flood-color="#1b1226" flood-opacity="0.45" />
                    </filter>
                  </defs>

                  <g class="pet-body-group" data-pet-body filter="url(#pet-soft-shadow)">
                    <g data-pet-shape="robot-dog">
                      <path d="M44 70q-6-16 4-24 6 6 7 18z" fill="url(#pet-metal-warm)" stroke="#6a4526" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M96 70q6-16-4-24-6 6-7 18z" fill="url(#pet-metal-warm)" stroke="#6a4526" stroke-width="2.6" stroke-linejoin="round" />
                      <rect x="34" y="58" width="72" height="50" rx="21" fill="url(#pet-metal)" stroke="#33465c" stroke-width="2.8" />
                      <path d="M42 96q6 12 28 12t28-12z" fill="#8aa6bd" opacity="0.6" />
                      <path d="M48 61q22-10 44 0" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.85" />
                      <rect x="47" y="66" width="46" height="24" rx="12" fill="#17212e" stroke="#33465c" stroke-width="2.4" />
                      <ellipse cx="59" cy="78" rx="4.6" ry="5" fill="url(#pet-lens)" />
                      <ellipse cx="81" cy="78" rx="4.6" ry="5" fill="url(#pet-lens)" />
                      <circle cx="60.6" cy="76" r="1.6" fill="#ffffff" />
                      <circle cx="82.6" cy="76" r="1.6" fill="#ffffff" />
                      <path d="M64 95q6 4 12 0" fill="none" stroke="#33465c" stroke-width="2.6" stroke-linecap="round" />
                      <path d="M70 61v-9" stroke="#6a4526" stroke-width="2.6" stroke-linecap="round" />
                      <circle cx="70" cy="48" r="5" fill="#ffcf6b" stroke="#6a4526" stroke-width="2.2" />
                      <circle cx="70" cy="48" r="2" fill="#fff6d6" />
                    </g>

                    <g data-pet-shape="cat" data-hidden>
                      <path d="M98 96q22-6 20-26-4 14-16 16z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M42 68l-7-22 24 9z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M98 68l7-22-24 9z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M47 56l-3-10 11 4z" fill="#ffb3c0" />
                      <path d="M93 56l3-10-11 4z" fill="#ffb3c0" />
                      <ellipse cx="70" cy="80" rx="31" ry="28" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.8" />
                      <path d="M54 82q16 12 32 0 0 18-16 18t-16-18z" fill="url(#pet-fur-cream)" />
                      <path d="M52 62q8-7 16-1" fill="none" stroke="#ffd9a0" stroke-width="3" stroke-linecap="round" />
                      <ellipse cx="58" cy="74" rx="6.4" ry="7.2" fill="#ffffff" stroke="#3a2418" stroke-width="2" />
                      <ellipse cx="82" cy="74" rx="6.4" ry="7.2" fill="#ffffff" stroke="#3a2418" stroke-width="2" />
                      <ellipse cx="58" cy="74.5" rx="3.4" ry="4.6" fill="#2b6f5e" />
                      <ellipse cx="82" cy="74.5" rx="3.4" ry="4.6" fill="#2b6f5e" />
                      <circle cx="56.8" cy="72.6" r="1.3" fill="#ffffff" />
                      <circle cx="80.8" cy="72.6" r="1.3" fill="#ffffff" />
                      <path d="M67 86h6l-3 3z" fill="#d4736f" />
                      <path d="M70 89v3M70 92q-4 5-8 1M70 92q4 5 8 1" fill="none" stroke="#8a4720" stroke-width="1.9" stroke-linecap="round" />
                      <path d="M40 84l-10-3M40 89l-10 3M100 84l10-3M100 89l10 3" fill="none" stroke="#8a4720" stroke-width="2" stroke-linecap="round" />
                      <path d="M92 50l1.6 4 4.4.5-3.3 3 .9 4.3-3.6-2.1-3.6 2.1.9-4.3-3.3-3 4.4-.5z" fill="#fff0b8" />
                    </g>

                    <g data-pet-shape="dinosaur" data-hidden>
                      <path d="M98 96q16 4 18-14-6 8-14 6z" fill="url(#pet-scale)" stroke="#24603a" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M46 92q-14 4-18-8 8 4 14 0z" fill="url(#pet-scale)" stroke="#24603a" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M52 58q-3-12 5-16 4 6 2 14z" fill="#ffcf6b" stroke="#24603a" stroke-width="2.2" />
                      <path d="M66 50q0-13 8-16 3 7 0 14z" fill="#ffcf6b" stroke="#24603a" stroke-width="2.2" />
                      <path d="M80 54q2-11 9-12 1 7-2 12z" fill="#ffcf6b" stroke="#24603a" stroke-width="2.2" />
                      <ellipse cx="70" cy="78" rx="32" ry="29" fill="url(#pet-scale)" stroke="#24603a" stroke-width="2.8" />
                      <path d="M55 88q15 11 30 0 0 14-15 14t-15-14z" fill="#d8f5c4" />
                      <ellipse cx="59" cy="70" rx="7" ry="7.6" fill="#ffffff" stroke="#1d3a2a" stroke-width="2" />
                      <ellipse cx="83" cy="70" rx="7" ry="7.6" fill="#ffffff" stroke="#1d3a2a" stroke-width="2" />
                      <ellipse cx="60" cy="71" rx="3.4" ry="4.6" fill="#1d3a2a" />
                      <ellipse cx="84" cy="71" rx="3.4" ry="4.6" fill="#1d3a2a" />
                      <circle cx="58.6" cy="68.6" r="1.5" fill="#ffffff" />
                      <circle cx="82.6" cy="68.6" r="1.5" fill="#ffffff" />
                      <path d="M52 60q6-5 13-2" fill="none" stroke="#1d3a2a" stroke-width="2.6" stroke-linecap="round" />
                      <path d="M58 88q12 8 24 0" fill="none" stroke="#1d3a2a" stroke-width="2.6" stroke-linecap="round" />
                      <path d="M62 90l2 5 3-4M76 90l2 5 3-4" fill="#ffffff" stroke="#1d3a2a" stroke-width="1.6" stroke-linejoin="round" />
                      <ellipse cx="48" cy="84" rx="6" ry="4" fill="#ff9d8a" opacity="0.5" />
                    </g>

                    <g data-pet-shape="robot" data-hidden>
                      <path d="M70 40v-8" stroke="#4a5f78" stroke-width="2.6" stroke-linecap="round" />
                      <circle cx="70" cy="28" r="5" fill="#7ff0d4" stroke="#2c4258" stroke-width="2.2" />
                      <circle cx="70" cy="28" r="2" fill="#ffffff" />
                      <rect x="38" y="44" width="64" height="56" rx="18" fill="url(#pet-metal)" stroke="#33465c" stroke-width="2.8" />
                      <path d="M48 48q22-9 44 0" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.9" />
                      <rect x="46" y="58" width="48" height="28" rx="14" fill="#141d29" stroke="#33465c" stroke-width="2.4" />
                      <ellipse cx="70" cy="72" rx="12" ry="9" fill="url(#pet-lens)" />
                      <ellipse cx="66" cy="69" rx="3.4" ry="2.6" fill="#ffffff" opacity="0.9" />
                      <circle cx="70" cy="72" r="3" fill="#0b3f52" />
                      <path d="M58 96h24" stroke="#4a5f78" stroke-width="2.6" stroke-linecap="round" />
                      <path d="M38 66q-9 2-9 12 0 8 8 9" fill="none" stroke="#4a5f78" stroke-width="2.6" stroke-linecap="round" />
                      <path d="M102 66q9 2 9 12 0 8-8 9" fill="none" stroke="#4a5f78" stroke-width="2.6" stroke-linecap="round" />
                      <circle cx="50" cy="66" r="2.4" fill="#ffcf6b" />
                      <circle cx="90" cy="66" r="2.4" fill="#ff8fb5" />
                    </g>

                    <g data-pet-shape="fox" data-hidden>
                      <path d="M100 92q24-10 18-32-2 18-14 22z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M46 62l-6-24 24 11z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M94 62l6-24-24 11z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.6" stroke-linejoin="round" />
                      <path d="M50 50l-2-9 10 5z" fill="#4a2a1c" />
                      <path d="M90 50l2-9-10 5z" fill="#4a2a1c" />
                      <path d="M40 84q4-26 30-26t30 26q-10 18-30 18t-30-18z" fill="url(#pet-fur-orange)" stroke="#8a4720" stroke-width="2.8" />
                      <path d="M42 84q10 8 16 0 6 12 12 12t12-12q6 8 16 0-6 18-28 18t-28-18z" fill="url(#pet-fur-cream)" />
                      <ellipse cx="58" cy="74" rx="5.6" ry="6.4" fill="#ffffff" stroke="#3a2418" stroke-width="2" />
                      <ellipse cx="82" cy="74" rx="5.6" ry="6.4" fill="#ffffff" stroke="#3a2418" stroke-width="2" />
                      <ellipse cx="58" cy="74.5" rx="3" ry="4.2" fill="#c9742c" />
                      <ellipse cx="82" cy="74.5" rx="3" ry="4.2" fill="#c9742c" />
                      <circle cx="57" cy="72.8" r="1.2" fill="#ffffff" />
                      <circle cx="81" cy="72.8" r="1.2" fill="#ffffff" />
                      <path d="M67 85h6l-3 3.4z" fill="#3a2418" />
                      <path d="M70 88.4v2.6" stroke="#3a2418" stroke-width="1.8" stroke-linecap="round" />
                      <path d="M46 88q14 10 24 0" fill="none" stroke="#ff6f61" stroke-width="6" stroke-linecap="round" />
                      <path d="M86 88q6 6 14 4" fill="none" stroke="#ff6f61" stroke-width="6" stroke-linecap="round" />
                    </g>

                    <g data-pet-shape="octopus" data-hidden>
                      <path d="M52 52q-14-6-20 4 12 0 18 8z" fill="#ff8fb5" stroke="#5c3a9e" stroke-width="2.4" stroke-linejoin="round" />
                      <path d="M88 52q14-6 20 4-12 0-18 8z" fill="#ff8fb5" stroke="#5c3a9e" stroke-width="2.4" stroke-linejoin="round" />
                      <path d="M38 84q0-32 32-32t32 32q0 10-8 10-5 0-7-8-3 18-17 18t-17-18q-2 8-7 8-8 0-8-10z" fill="url(#pet-grape)" stroke="#4a2d80" stroke-width="2.8" />
                      <path d="M48 58q10-8 22-6" fill="none" stroke="#f0e0ff" stroke-width="3" stroke-linecap="round" opacity="0.85" />
                      <ellipse cx="60" cy="78" rx="6.4" ry="7.4" fill="#ffffff" stroke="#2b1f3d" stroke-width="2" />
                      <ellipse cx="80" cy="78" rx="6.4" ry="7.4" fill="#ffffff" stroke="#2b1f3d" stroke-width="2" />
                      <ellipse cx="60" cy="79" rx="3.2" ry="4.6" fill="#2b1f3d" />
                      <ellipse cx="80" cy="79" rx="3.2" ry="4.6" fill="#2b1f3d" />
                      <circle cx="59" cy="77" r="1.3" fill="#ffffff" />
                      <circle cx="79" cy="77" r="1.3" fill="#ffffff" />
                      <path d="M64 90q6 5 12 0" fill="none" stroke="#2b1f3d" stroke-width="2.4" stroke-linecap="round" />
                      <ellipse cx="48" cy="86" rx="5" ry="3.2" fill="#ff9dc0" opacity="0.55" />
                      <ellipse cx="92" cy="86" rx="5" ry="3.2" fill="#ff9dc0" opacity="0.55" />
                      <path d="M42 92q-4 8 2 12M56 96q-2 8 4 11M70 97q0 8 6 10M84 96q2 8-2 11M98 92q4 8-2 12" fill="none" stroke="#5c3a9e" stroke-width="2.4" stroke-linecap="round" />
                    </g>

                    <g data-pet-shape="custom" data-hidden>
                      <path d="M46 96q-6-34 24-38 30 4 24 38-8 10-24 10t-24-10z" fill="url(#pet-fur-cream)" stroke="#8a6a3e" stroke-width="2.8" />
                      <circle cx="52" cy="70" r="2.4" fill="#ffb3c0" />
                      <circle cx="88" cy="70" r="2.4" fill="#ffb3c0" />
                      <text x="70" y="92" text-anchor="middle" font-size="26" font-weight="700" fill="#8a6a3e">?</text>
                    </g>

                    <g data-pet-shape="none" data-hidden>
                      <ellipse cx="70" cy="96" rx="26" ry="8" fill="#3b3552" stroke="#8fa3bb" stroke-width="2" stroke-dasharray="5 5" />
                      <path d="M70 62v26M58 75h24" stroke="#8fa3bb" stroke-width="2.6" stroke-linecap="round" />
                    </g>
                  </g>
                </svg>
              </div>
              <div class="pet-fireflies" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
            </div>
            <p class="pet-preview-label">把鼠标移进来，点一下宠物试试</p>
          </div>
          <fieldset class="choice-grid choice-grid--pet-types">
            <legend class="sr-only">选择一种屏幕宠物</legend>
            {PET_TYPE_OPTIONS.map((option, index) => (
              <label class="choice-card choice-card--compact">
                <input type="radio" name="petType" value={option.id} checked={index === 0} />
                <span class="choice-card-mark" aria-hidden="true">✦</span>
                <span class="choice-card-label">{option.label}</span>
              </label>
            ))}
          </fieldset>
        </div>

        <div class="upgrade-pet-details">
          <label class="builder-field">
            <span>宠物叫什么名字 <em>可以不写</em></span>
            <input name="petName" type="text" maxlength="20" autocomplete="off" placeholder="例如：豆豆" />
          </label>
          <label class="builder-field" data-pet-custom-field hidden>
            <span>描述你的宠物 <em>必填</em></span>
            <input name="petCustom" type="text" maxlength="40" autocomplete="off" placeholder="例如：一只会发光的小水母" />
          </label>
        </div>

        <fieldset class="choice-grid choice-grid--pet-actions">
          <legend>它会做什么？最多选 2 个</legend>
          {PET_ACTION_OPTIONS.map((option) => (
            <label class="choice-card choice-card--compact">
              <input type="checkbox" name="petActions" value={option.id} />
              <span class="choice-card-mark" aria-hidden="true">+</span>
              <span class="choice-card-label">{option.label}</span>
            </label>
          ))}
        </fieldset>
        <p class="builder-error" data-error-for="2" role="alert"></p>
      </section>

    </div>

    <div class="builder-actions">
      <button class="builder-button builder-button--quiet" type="button" data-previous hidden>上一步</button>
      <span class="builder-actions-spacer"></span>
      <button class="builder-button builder-button--primary" type="button" data-generate>生成这一步的提示词</button>
    </div>
  </form>

  <section class="builder-result" data-result hidden aria-labelledby="upgrade-result-title">
    <div class="result-heading">
      <p class="eyebrow">step prompt / 本步提示词</p>
      <h3 id="upgrade-result-title" data-result-title>复制这段话，回到上次做网站的那个对话。</h3>
      <p data-result-lead>把它发给你上次使用的 AI 工具。它会只改这一步，其他内容保持不动。</p>
    </div>
    <pre class="prompt-output" data-prompt-output tabindex="0"></pre>
    <div class="result-actions">
      <button class="builder-button builder-button--primary" type="button" data-copy>复制本步提示词</button>
      <button class="builder-button builder-button--quiet" type="button" data-edit>返回修改</button>
    </div>
    <p class="copy-feedback" data-copy-feedback role="status" aria-live="polite"></p>
    <button class="builder-button builder-button--secondary result-next" type="button" data-result-next hidden>这一步改好了，下一步 →</button>

    <div class="upgrade-checklist">
      <h4>这一步改完，检查这 4 件事</h4>
      <ul>
        <li>网站名字和自我介绍还在吗？</li>
        <li>原来的板块有没有被删掉？</li>
        <li>前面做好的升级还在吗？</li>
        <li>新效果会不会挡住文字和按钮？</li>
      </ul>
    </div>

    <div class="roadshow-card" data-roadshow-card hidden>
      <h4>路演卡：站上台，照着说</h4>
      <pre class="roadshow-output" data-roadshow-output tabindex="0"></pre>
      <button class="builder-button builder-button--quiet" type="button" data-copy-roadshow>复制路演卡</button>
      <p class="copy-feedback" data-roadshow-feedback role="status" aria-live="polite"></p>
    </div>
  </section>
</section>

<script>
  // @ts-nocheck
  import {
    buildRoadshowCard,
    buildUpgradeStepPrompt,
    createUpgradeState,
    DEFAULT_AVATAR_EFFECTS,
    MAX_AVATAR_EFFECTS,
    MAX_PET_ACTIONS,
    validateUpgradeStep,
    UPGRADE_STEP_LABELS,
    UPGRADE_STEP_PROMPTS,
  } from '../lib/planet-upgrade.mjs';
  import { copyTextToClipboard } from '../lib/ai-planet-builder.mjs';
  import 'mesh-avatar-element';

  const root = document.querySelector('.upgrade-builder');
  const form = root?.querySelector('[data-upgrade-form]');

  if (root && form) {
    const panels = [...root.querySelectorAll('[data-step-panel]')];
    const state = createUpgradeState();
    let avatarOrder = [...state.avatarEffects];
    let currentStep = 0;
    const progressBar = root.querySelector('[data-progress-bar]');
    const progressCurrent = root.querySelector('[data-progress-current]');
    const progressLabel = root.querySelector('[data-progress-label]');
    const previousButton = root.querySelector('[data-previous]');
    const generateButton = root.querySelector('[data-generate]');
    const result = root.querySelector('[data-result]');
    const resultTitle = root.querySelector('[data-result-title]');
    const resultLead = root.querySelector('[data-result-lead]');
    const resultNext = root.querySelector('[data-result-next]');
    const promptOutput = root.querySelector('[data-prompt-output]');
    const copyFeedback = root.querySelector('[data-copy-feedback]');
    const roadshowOutput = root.querySelector('[data-roadshow-output]');
    const roadshowFeedback = root.querySelector('[data-roadshow-feedback]');
    const roadshowCard = root.querySelector('[data-roadshow-card]');
    const petCustomField = root.querySelector('[data-pet-custom-field]');

    const named = (name) => form.elements.namedItem(name);
    const checkedValues = (name) => [...form.querySelectorAll(`input[name="${name}"]:checked`)].map((element) => element.value);

    const readState = () => {
      state.avatarEffects = avatarOrder.length ? [...avatarOrder] : checkedValues('avatarEffects');
      state.cursorEffect = named('cursorEffect')?.value || 'none';
      state.petType = named('petType')?.value || 'none';
      state.petCustom = named('petCustom')?.value || '';
      state.petName = named('petName')?.value || '';
      state.petActions = checkedValues('petActions');
      return state;
    };

    const showError = (stepIndex, message) => {
      const error = root.querySelector(`[data-error-for="${stepIndex}"]`);
      if (error) error.textContent = message;
    };

    const clearErrors = () => root.querySelectorAll('.builder-error').forEach((error) => { error.textContent = ''; });

    const showStep = (stepIndex) => {
      currentStep = stepIndex;
      panels.forEach((panel, index) => {
        const active = index === currentStep;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
      progressCurrent.textContent = String(currentStep + 1);
      progressLabel.textContent = UPGRADE_STEP_LABELS[currentStep];
      progressBar.style.width = `${((currentStep + 1) / 3) * 100}%`;
      previousButton.hidden = currentStep === 0;
      generateButton.hidden = false;
      generateButton.textContent = currentStep === 0 ? '生成头像提示词' : currentStep === 1 ? '生成鼠标特效提示词' : '生成宠物提示词';
      result.hidden = true;
      clearErrors();
    };

    form.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.name === 'avatarEffects') {
        const selected = checkedValues('avatarEffects');
        if (target.checked && selected.length > MAX_AVATAR_EFFECTS) {
          target.checked = false;
          showError(0, `头像效果最多选择 ${MAX_AVATAR_EFFECTS} 个。`);
          return;
        }
        avatarOrder = avatarOrder.filter((value) => value !== target.value);
        if (target.checked) avatarOrder.push(target.value);
        document.dispatchEvent(new CustomEvent('upgrade:avatar-change', { detail: { effects: [...avatarOrder] } }));
      }
      if (target.name === 'petActions') {
        const selected = checkedValues('petActions');
        if (target.checked && selected.length > MAX_PET_ACTIONS) {
          target.checked = false;
          showError(2, `宠物动作最多选择 ${MAX_PET_ACTIONS} 个。`);
        }
      }
      if (target.name === 'petType') {
        if (petCustomField) petCustomField.hidden = target.value !== 'custom';
        document.dispatchEvent(new CustomEvent('upgrade:pet-change', { detail: { petType: target.value } }));
      }
      if (target.name === 'cursorEffect') {
        document.dispatchEvent(new CustomEvent('upgrade:cursor-change', { detail: { cursorEffect: target.value } }));
      }
    });

    const openResult = (stepIndex, prompt, skipped) => {
      const step = UPGRADE_STEP_PROMPTS[stepIndex];
      resultTitle.textContent = skipped ? `第 ${stepIndex + 1} 步：这一步先跳过` : step.resultTitle;
      resultLead.textContent = skipped
        ? '这一步选择「这次不加」，所以不用复制提示词。可以直接进入下一步。'
        : '这段只改这一步。复制给上次做网站的那个 AI，确认改好后再进入下一步。';
      promptOutput.textContent = prompt;
      promptOutput.hidden = skipped;
      root.querySelector('[data-copy]').hidden = skipped;
      resultNext.hidden = stepIndex === 2;
      resultNext.textContent = stepIndex === 0 ? '头像改好了，下一步：鼠标特效 →' : '鼠标特效改好了，下一步：屏幕宠物 →';
      if (roadshowCard) roadshowCard.hidden = stepIndex !== 2;
      if (stepIndex === 2) {
        readState();
        roadshowOutput.textContent = buildRoadshowCard(state);
      }
      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    generateButton?.addEventListener('click', () => {
      readState();
      const validation = validateUpgradeStep(state, currentStep);
      if (!validation.valid) {
        showError(currentStep, validation.message);
        return;
      }
      const prompt = buildUpgradeStepPrompt(state, currentStep);
      if (!prompt && (currentStep === 1 || currentStep === 2)) {
        openResult(currentStep, '', true);
        return;
      }
      if (!prompt) {
        showError(currentStep, '请先选择至少一个选项。');
        return;
      }
      openResult(currentStep, prompt, false);
    });

    resultNext?.addEventListener('click', () => {
      showStep(Math.min(2, currentStep + 1));
      root.querySelector(`[data-step-panel="${currentStep}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    previousButton?.addEventListener('click', () => showStep(Math.max(0, currentStep - 1)));

    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      const copied = await copyTextToClipboard(promptOutput.textContent);
      copyFeedback.textContent = copied
        ? '本步提示词已复制，可以粘贴给 AI 了。'
        : '复制没有成功，请长按或拖动选中文字复制。';
      if (!copied) promptOutput.focus();
    });

    root.querySelector('[data-copy-roadshow]')?.addEventListener('click', async () => {
      const copied = await copyTextToClipboard(roadshowOutput.textContent);
      roadshowFeedback.textContent = copied
        ? '路演卡已复制。'
        : '复制没有成功，请长按或拖动选中文字复制。';
      if (!copied) roadshowOutput.focus();
    });

    root.querySelector('[data-edit]')?.addEventListener('click', () => {
      result.hidden = true;
      showStep(currentStep);
    });

    showStep(0);
  }

  // 头像预览：官方 Mesh 运行时。选项真实改变视线、头部、表情、浮动与发光。
  try {
    const preview = document.querySelector('[data-avatar-preview]');
    const mesh = document.querySelector('[data-avatar-mesh]');
    const fallback = document.querySelector('[data-avatar-mesh-fallback]');
    const bubbleCard = document.querySelector('[data-avatar-bubble-card]');
    const bubbleText = document.querySelector('[data-avatar-bubble]');
    const sparkles = document.querySelector('.avatar-sparkles');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    let activeEffects = [...DEFAULT_AVATAR_EFFECTS];
    let avatar = null;
    let resetTimer = 0;
    let lastPat = 0;
    let expressionIndex = -1;
    let touchPatAt = 0;
    let chosenExpression = 'neutral';
    // 只接管视线和头部参数；眼睑交给运行时，保证「会眨眼」和表情里的半闭眼都有效。
    const manual = {};

    const EXPRESSIONS = [
      { name: 'shy', motion: 'tilt', bubble: '嘿嘿，有点害羞～' },
      { name: 'surprise', motion: 'surprise', bubble: '哇，被发现啦！' },
      { name: 'angry', motion: 'tilt', bubble: '哼，我可是很认真的！' },
      { name: 'neutral', motion: null, bubble: '今天也要发光！' },
    ];

    const setBubble = (text) => {
      if (bubbleText) bubbleText.textContent = text;
      bubbleCard?.classList.add('is-visible');
    };

    const hideBubble = () => bubbleCard?.classList.remove('is-visible');

    const commitParameters = () => avatar?.setParameters({ ...manual }, 1);

    const setExpression = (name, motion = null) => {
      if (!avatar) return;
      avatar.setExpression(name);
      if (motion) avatar.play(motion);
    };

    // 表情保持到下一次点击，孩子能清楚看到变化；气泡自己淡出。
    const resetBubble = (delay) => {
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(hideBubble, delay);
    };

    const cycleExpression = () => {
      if (!activeEffects.includes('expression')) return;
      expressionIndex = (expressionIndex + 1) % EXPRESSIONS.length;
      const expression = EXPRESSIONS[expressionIndex];
      chosenExpression = expression.name;
      setExpression(expression.name, expression.motion);
      setBubble(expression.bubble);
      resetBubble(2600);
      if (sparkles) {
        sparkles.classList.add('is-bursting');
        window.setTimeout(() => sparkles.classList.remove('is-bursting'), 600);
      }
    };

    const patHead = () => {
      if (!activeEffects.includes('head-pat')) return;
      const now = performance.now();
      if (now - lastPat < 1100) return;
      lastPat = now;
      setExpression('shy', 'tilt');
      setBubble('嘿嘿，好痒～');
      resetBubble(1700);
      window.setTimeout(() => {
        if (avatar && chosenExpression !== 'shy') avatar.setExpression(chosenExpression);
      }, 1700);
    };

    const applyEffects = () => {
      if (!preview) return;
      preview.classList.toggle('fx-follow', activeEffects.includes('follow-cursor'));
      preview.classList.toggle('fx-glow', activeEffects.includes('glow'));
      preview.classList.toggle('fx-float', activeEffects.includes('float'));
      preview.classList.toggle('fx-blink', activeEffects.includes('blink'));
      preview.classList.toggle('fx-pat', activeEffects.includes('head-pat'));
      preview.classList.toggle('fx-expression', activeEffects.includes('expression'));
      // 关闭运行时的随机动作：giggle / no / greet 会连续闭眼 1 到 2 秒。
      avatar?.setAutoMotion(false);
      avatar?.setAutoIdle(false);
      // 不勾「会眨眼」时把眼睑固定在睁开状态；勾上后交还给运行时做自然短眨。
      if (activeEffects.includes('blink')) {
        delete manual.eyeLOpen;
        delete manual.eyeROpen;
      } else {
        manual.eyeLOpen = 1;
        manual.eyeROpen = 1;
      }
      commitParameters();
    };

    document.addEventListener('upgrade:avatar-change', (event) => {
      activeEffects = event.detail.effects;
      applyEffects();
    });

    const connectAvatar = async () => {
      if (!mesh) return;
      try {
        await customElements.whenDefined('mesh-avatar');
        const loaded = await mesh.ready;
        avatar = loaded;
        avatar.setAutoMotion(false);
        avatar.setAutoIdle(false);
        commitParameters();
        if (reduceMotion) {
          mesh.paused = true;
        }
        applyEffects();
      } catch {
        if (fallback) fallback.hidden = false;
      }
    };

    if (mesh) {
      mesh.addEventListener('error', () => {
        if (fallback) fallback.hidden = false;
      });

      mesh.addEventListener('pointermove', (event) => {
        if (!avatar || reduceMotion || !finePointer) return;
        const rect = mesh.getBoundingClientRect();
        const nx = (event.clientX - rect.left) / rect.width - 0.5;
        const ny = (event.clientY - rect.top) / rect.height - 0.5;
        if (activeEffects.includes('follow-cursor')) {
          manual.gazeX = Math.max(-1, Math.min(1, nx * 2.2));
          manual.gazeY = Math.max(-1, Math.min(1, ny * 1.8));
          manual.angleX = Math.max(-8, Math.min(8, nx * 14));
          manual.angleY = Math.max(-6, Math.min(6, -ny * 10));
          commitParameters();
        }
        if ((event.clientY - rect.top) / rect.height < 0.32) patHead();
      });

      mesh.addEventListener('pointerleave', () => {
        if (!avatar) return;
        delete manual.gazeX;
        delete manual.gazeY;
        delete manual.angleX;
        delete manual.angleY;
        commitParameters();
        hideBubble();
      });

      mesh.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
        if (!activeEffects.includes('head-pat')) return;
        const rect = mesh.getBoundingClientRect();
        if ((event.clientY - rect.top) / rect.height < 0.32) {
          touchPatAt = performance.now();
          patHead();
        }
      });

      mesh.addEventListener('click', (event) => {
        if (!activeEffects.includes('expression')) return;
        if ((event.pointerType === 'touch' || event.pointerType === 'pen') && performance.now() - touchPatAt < 500) return;
        cycleExpression();
      });

      mesh.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (!activeEffects.includes('expression')) return;
        event.preventDefault();
        cycleExpression();
      });

      connectAvatar();
      applyEffects();
    }
  } catch {
    // 预览失败时保持静态，选项卡照常可用。
  }
  // 鼠标特效预览：五种效果在颜色、形状、运动方向上明显不同。
  try {
    const canvas = document.querySelector('[data-trail-canvas]');
    const frame = document.querySelector('[data-trail-preview]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    let cursorStyle = 'none';

    document.addEventListener('upgrade:cursor-change', (event) => {
      cursorStyle = event.detail.cursorEffect;
    });

    if (canvas instanceof HTMLCanvasElement && frame && !reduceMotion) {
      const context = canvas.getContext('2d');
      if (context) {
        const particles = [];
        let lastPointer = null;
        let frameId = 0;

        const resize = () => {
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const rect = frame.getBoundingClientRect();
          canvas.width = Math.max(1, Math.round(rect.width * ratio));
          canvas.height = Math.max(1, Math.round(rect.height * ratio));
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
        };

        const draw = () => {
          const rect = frame.getBoundingClientRect();
          context.clearRect(0, 0, rect.width, rect.height);

          for (let index = particles.length - 1; index >= 0; index -= 1) {
            const particle = particles[index];
            particle.life -= particle.decay;
            particle.x += particle.vx;
            particle.y += particle.vy;
            particle.vx *= particle.drag;
            particle.vy *= particle.drag;
            if (particle.kind === 'bubble') particle.vy -= 0.012;
            if (particle.kind === 'ripple') particle.radius += 1.6;

            if (particle.life <= 0) {
              particles.splice(index, 1);
              continue;
            }

            const alpha = Math.max(0, Math.min(1, particle.life));
            if (particle.kind === 'pixel') {
              context.fillStyle = `hsla(${particle.hue}, 88%, 62%, ${alpha})`;
              context.fillRect(particle.x - particle.size / 2, particle.y - particle.size / 2, particle.size, particle.size);
            } else if (particle.kind === 'bubble') {
              context.beginPath();
              context.strokeStyle = `hsla(${particle.hue}, 90%, 72%, ${alpha * 0.95})`;
              context.lineWidth = 1.6;
              context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
              context.stroke();
              context.fillStyle = `hsla(${particle.hue}, 95%, 92%, ${alpha * 0.35})`;
              context.fill();
            } else if (particle.kind === 'ripple') {
              context.beginPath();
              context.strokeStyle = `hsla(${particle.hue}, 92%, 64%, ${alpha})`;
              context.lineWidth = 2.6;
              context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
              context.stroke();
            } else if (particle.kind === 'star') {
              context.fillStyle = `hsla(${particle.hue}, 100%, 78%, ${alpha})`;
              context.beginPath();
              for (let point = 0; point < 8; point += 1) {
                const angle = (Math.PI / 4) * point;
                const radius = point % 2 === 0 ? particle.size : particle.size * 0.4;
                const px = particle.x + Math.cos(angle) * radius;
                const py = particle.y + Math.sin(angle) * radius;
                if (point === 0) context.moveTo(px, py);
                else context.lineTo(px, py);
              }
              context.closePath();
              context.fill();
            } else {
              context.beginPath();
              context.fillStyle = `hsla(${particle.hue}, 96%, 70%, ${alpha * 0.9})`;
              context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
              context.fill();
            }
          }

          frameId = particles.length > 0 ? requestAnimationFrame(draw) : 0;
        };

        const spawn = (x, y, count) => {
          for (let index = 0; index < count; index += 1) {
            if (cursorStyle === 'stardust') {
              particles.push({
                x, y, kind: 'star',
                vx: (Math.random() - 0.5) * 0.9,
                vy: (Math.random() - 0.5) * 0.9 - 0.15,
                hue: 205 + Math.random() * 40,
                life: 0.85 + Math.random() * 0.15,
                decay: 0.022,
                size: 2 + Math.random() * 2.6,
                drag: 0.97,
              });
            } else if (cursorStyle === 'rainbow') {
              particles.push({
                x, y, kind: 'dot',
                vx: (Math.random() - 0.5) * 1.1,
                vy: (Math.random() - 0.5) * 1.1,
                hue: (performance.now() / 4 + index * 22) % 360,
                life: 0.8 + Math.random() * 0.2,
                decay: 0.026,
                size: 2.4 + Math.random() * 3.2,
                drag: 0.96,
              });
            } else if (cursorStyle === 'bubbles') {
              particles.push({
                x: x + (Math.random() - 0.5) * 26, y, kind: 'bubble',
                vx: (Math.random() - 0.5) * 0.35,
                vy: -0.5 - Math.random() * 0.5,
                hue: 188 + Math.random() * 24,
                life: 1,
                decay: 0.012,
                size: 3 + Math.random() * 4.5,
                drag: 0.995,
              });
            } else if (cursorStyle === 'pixel') {
              particles.push({
                x: Math.round(x / 6) * 6, y: Math.round(y / 6) * 6, kind: 'pixel',
                vx: (Math.random() - 0.5) * 1.2,
                vy: (Math.random() - 0.5) * 1.2,
                hue: 150 + Math.random() * 40,
                life: 0.75 + Math.random() * 0.25,
                decay: 0.03,
                size: 5 + Math.random() * 4,
                drag: 0.94,
              });
            } else if (cursorStyle === 'ripple') {
              if (index === 0) {
                particles.push({
                  x, y, kind: 'ripple',
                  vx: 0, vy: 0,
                  hue: 268,
                  life: 1,
                  decay: 0.03,
                  radius: 3,
                  size: 0,
                  drag: 1,
                });
              }
            }
          }
          if (particles.length > 160) particles.splice(0, particles.length - 160);
          if (frameId === 0) frameId = requestAnimationFrame(draw);
        };

        resize();
        window.addEventListener('resize', resize, { passive: true });
        if (typeof ResizeObserver === 'function') {
          new ResizeObserver(() => {
            if (frame.getBoundingClientRect().width > 0) resize();
          }).observe(frame);
        }

        if (finePointer) {
          frame.addEventListener('pointermove', (event) => {
            if (cursorStyle === 'none') return;
            const rect = frame.getBoundingClientRect();
            const point = { x: event.clientX - rect.left, y: event.clientY - rect.top };
            const previous = lastPointer || point;
            const distance = Math.hypot(point.x - previous.x, point.y - previous.y);
            spawn(point.x, point.y, Math.min(6, Math.max(1, Math.ceil(distance / 9))));
            lastPointer = point;
          }, { passive: true });
        }

        frame.addEventListener('pointerdown', (event) => {
          const rect = frame.getBoundingClientRect();
          spawn(event.clientX - rect.left, event.clientY - rect.top, 10);
        });
      }
    }
  } catch {
    // 尾焰预览失败不影响选择。
  }

  // 宠物预览：切换类型、跟随鼠标、点击跳跃。
  try {
    const diorama = document.querySelector('[data-pet-preview]');
    const figure = document.querySelector('[data-pet-avatar]');
    const shapes = [...document.querySelectorAll('[data-pet-shape]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    const showShape = (petType) => {
      shapes.forEach((shape) => {
        shape.toggleAttribute('data-hidden', shape.dataset.petShape !== petType);
      });
    };

    document.addEventListener('upgrade:pet-change', (event) => {
      showShape(event.detail.petType);
    });

    if (figure && diorama && !reduceMotion && finePointer) {
      diorama.addEventListener('pointermove', (event) => {
        const rect = diorama.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        figure.style.transform = `translate(${x * 30}px, ${y * 14}px)`;
      });
      diorama.addEventListener('pointerleave', () => {
        figure.style.transform = 'translate(0, 0)';
      });
    }

    figure?.addEventListener('pointerdown', () => {
      figure.classList.add('is-jumping');
      window.setTimeout(() => figure.classList.remove('is-jumping'), 460);
    });
  } catch {
    // 宠物预览失败不影响选择。
  }
</script>
