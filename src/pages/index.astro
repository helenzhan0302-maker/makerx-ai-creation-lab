---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="site-shell">
    <main id="main-content">
      <section class="hero-stage" aria-labelledby="hero-title">
        <header class="site-header" data-reveal style="--reveal-delay: 40ms">
          <a class="brand-mark" href="/" aria-label="MakerX AI 造物实验室首页">
            <span aria-hidden="true">✦</span>
          </a>
          <nav class="site-nav" aria-label="主导航">
            <a href="#projects">项目档案</a>
          </nav>
        </header>

        <div class="stage-grid" aria-hidden="true"></div>

        <div class="stage-corner stage-corner--top-left" data-reveal style="--reveal-delay: 180ms">
          <span class="corner-star" aria-hidden="true">✦</span>
          <span>MAKE<br />EXPLORE<br />CREATE<br />TOGETHER</span>
        </div>

        <p class="stage-corner stage-corner--top-right" data-reveal style="--reveal-delay: 220ms">
          用 AI <span aria-hidden="true">｜</span> 让创意成为现实
        </p>

        <div class="hero-composition">
          <p class="hero-kicker" data-reveal style="--reveal-delay: 300ms">AI CREATION LAB</p>
          <h1 id="hero-title" class="wordmark" data-reveal style="--reveal-delay: 390ms">
            Maker<span class="wordmark-x">X</span>
          </h1>
          <p class="hero-subtitle" data-reveal style="--reveal-delay: 470ms">
            <span aria-hidden="true">✦</span>
            AI 造物实验室
            <span aria-hidden="true">✦</span>
          </p>
          <p class="hero-claim" data-reveal style="--reveal-delay: 550ms">把脑海里的想法，动手造出来。</p>
        </div>

        <svg class="stage-art" viewBox="0 0 1200 720" aria-hidden="true" focusable="false" data-reveal style="--reveal-delay: 260ms">
          <defs>
            <linearGradient id="makerx-cyan" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#dffaff" />
              <stop offset="0.48" stop-color="#55d7f9" />
              <stop offset="1" stop-color="#7ba4f0" />
            </linearGradient>
            <linearGradient id="makerx-violet" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#87e8ff" />
              <stop offset="0.52" stop-color="#536ef0" />
              <stop offset="1" stop-color="#bc8dff" />
            </linearGradient>
            <radialGradient id="makerx-sphere" cx="34%" cy="28%" r="70%">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="0.2" stop-color="#9ae9ff" />
              <stop offset="0.65" stop-color="#687df3" />
              <stop offset="1" stop-color="#7f55df" />
            </radialGradient>
            <filter id="makerx-glow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="9" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <ellipse class="orbit orbit--one" cx="600" cy="360" rx="510" ry="154" transform="rotate(-13 600 360)" />
          <ellipse class="orbit orbit--two" cx="600" cy="360" rx="438" ry="132" transform="rotate(19 600 360)" />
          <ellipse class="orbit orbit--three" cx="600" cy="360" rx="360" ry="108" transform="rotate(-31 600 360)" />

          <g class="art-ring" transform="translate(180 148) rotate(-23)">
            <ellipse rx="75" ry="31" fill="url(#makerx-cyan)" opacity="0.84" />
            <ellipse rx="75" ry="31" fill="none" stroke="#ffffff" stroke-opacity="0.74" stroke-width="5" transform="rotate(56)" />
            <ellipse rx="50" ry="18" fill="none" stroke="#546df0" stroke-opacity="0.6" stroke-width="6" transform="rotate(-36)" />
          </g>

          <g class="art-cross" transform="translate(860 315) rotate(28)">
            <rect x="-40" y="-124" width="80" height="248" rx="32" fill="url(#makerx-violet)" />
            <rect x="-124" y="-40" width="248" height="80" rx="32" fill="url(#makerx-cyan)" />
            <path d="M-25-111C-5-92 12-76 38-58C52-49 65-37 79-17C39-35 14-32-14-8C-38 12-56 32-79 54C-65 13-45-15-27-36C-7-58 11-83 25-111Z" fill="#ffffff" opacity="0.2" />
          </g>

          <g class="art-cube" transform="translate(152 520) rotate(-17)">
            <path d="M0-43 50-14 48 44 0 71-49 43-50-14Z" fill="url(#makerx-violet)" opacity="0.82" />
            <path d="M0-43 0 13 48 44 50-14Z" fill="#b3f2ff" opacity="0.54" />
            <path d="M0-43-50-14 0 13 50-14Z" fill="#ffffff" opacity="0.42" />
          </g>

          <circle class="art-sphere art-sphere--large" cx="955" cy="152" r="28" fill="url(#makerx-sphere)" filter="url(#makerx-glow)" />
          <circle class="art-sphere art-sphere--small" cx="1064" cy="421" r="17" fill="url(#makerx-sphere)" />
          <circle class="art-sphere art-sphere--tiny" cx="1010" cy="450" r="9" fill="#79ddfa" />

          <g class="art-spark art-spark--left" transform="translate(90 110)">
            <path d="M0-18 4-4 18 0 4 4 0 18-4 4-18 0-4-4Z" fill="#111315" />
          </g>
          <g class="art-spark art-spark--right" transform="translate(1090 565)">
            <path d="M0-13 3-3 13 0 3 3 0 13-3 3-13 0-3-3Z" fill="#111315" />
          </g>
        </svg>

        <div class="stage-bottom" data-reveal style="--reveal-delay: 650ms">
          <p>项目制学习 <span aria-hidden="true">×</span> AI 工具 <span aria-hidden="true">×</span> 数字作品集</p>
          <p class="stage-status"><span aria-hidden="true"></span>持续构建</p>
        </div>

        <a class="scroll-cue" href="#projects" data-reveal style="--reveal-delay: 760ms">
          <span>向下探索</span>
          <span class="scroll-line" aria-hidden="true"></span>
        </a>
      </section>

      <section class="archive-section" id="projects" aria-labelledby="projects-title">
        <div class="archive-panel" data-reveal style="--reveal-delay: 80ms">
          <div>
            <p class="section-label">project archive / in progress</p>
            <h2 id="projects-title">项目会一直长出来。</h2>
          </div>
          <div>
            <p class="archive-copy">
              MakerX 不是一门固定不变的课程。我们会在每一次制作、测试和分享之后，把新的项目继续放进这个档案里。
            </p>
            <p class="archive-status">课程与项目持续研发中</p>
            <a class="primary-link" href="#projects">探索造物项目 <span aria-hidden="true">↘</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p class="footer-brand">MakerX AI 造物实验室</p>
      <p class="footer-meta">把脑海里的想法，动手造出来。<br />静态原型 · 持续更新</p>
    </footer>
  </div>
</BaseLayout>

<script is:inline>
  const root = document.documentElement;
  root.classList.add('js');

  const revealItems = [...document.querySelectorAll('[data-reveal]')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** @param {Element} element */
  const show = (element) => element.classList.add('is-visible');

  if (reducedMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach(show);
  } else {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          show(entry.target);
          currentObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.12 },
    );

    revealItems.forEach((element) => observer.observe(element));
  }
</script>
