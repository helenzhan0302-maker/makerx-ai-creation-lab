---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/ai-planet-builder.css';
import '../../../styles/planet-upgrade.css';
import '../../../styles/picturebook.css';

const baseUrl = import.meta.env.BASE_URL;
const lessons = [
  {
    id: '01',
    label: '第 1 节课',
    title: '故事导演营',
    description: '从一个小小的想法，创造一个真正属于自己的故事。AI 一次问一个问题，你确认创意卡和完整故事后，保存 v1 故事档案。',
    meta: '完整故事',
    variant: 'story',
    href: `${baseUrl}lab/002-picturebook/lesson-1/`,
    action: '进入故事导演营',
  },
  {
    id: '02',
    label: '第 2 节课',
    title: '绘本造物营',
    description: '导入 v1，把完整故事拆成 6 页分镜，统一画风与主角长相，逐页生成并检查插画，最后完成首映礼。',
    meta: '分镜 + 绘本',
    variant: 'picture',
    href: `${baseUrl}lab/002-picturebook/lesson-2/`,
    action: '进入绘本造物营',
  },
];
---

<BaseLayout title="故事造物机｜MakerX AI 造物实验室" description="故事造物机：第一周把一个小念头变成完整故事，第二周把故事做成 6 页绘本并参加首映礼。">
  <div class="project-page-shell pb-page-shell">
    <header class="project-page-header">
      <a class="project-back-link" href={baseUrl}>← MakerX AI 造物实验室</a>
      <span class="project-page-status">实验编号 002 / 故事造物机</span>
    </header>

    <main id="main-content">
      <section class="project-intro pb-intro" aria-labelledby="project-title">
        <p class="eyebrow">project 002 / story maker</p>
        <h1 id="project-title">故事造物机</h1>
        <p class="project-intro-lead">第一周，把一个小小的想法变成完整故事；第二周，把故事做成一本 6 页绘本，最后放映给同伴看。</p>
      </section>

      <section class="lesson-hub pb-lesson-hub" aria-label="选择课次">
        {lessons.map((lesson) => (
          <a class={`lesson-card pb-lesson-card pb-lesson-card--${lesson.variant}`} href={lesson.href}>
            <div class="lesson-card-top pb-lesson-meta">
              <span class="lesson-card-index" aria-hidden="true">{lesson.id}</span>
              <span class="lesson-card-label">{lesson.label}</span>
              <span class="lesson-card-meta">{lesson.meta}</span>
            </div>
            <div class="pb-lesson-copy">
              <h2 class="lesson-card-title">{lesson.title}</h2>
              <p class="lesson-card-description">{lesson.description}</p>
              <span class="lesson-card-action">{lesson.action} <span aria-hidden="true">↗</span></span>
            </div>
            <div class="pb-lesson-art" aria-hidden="true">
              {lesson.variant === 'story' ? (
                <svg viewBox="0 0 160 160" focusable="false">
                  <path class="pb-story-path" d="M12 118c22-55 45 22 66-38s43 22 70-38" />
                  <circle class="pb-story-dot" cx="12" cy="118" r="4" />
                  <circle class="pb-story-dot" cx="78" cy="80" r="4" />
                  <circle class="pb-story-dot" cx="148" cy="42" r="4" />
                </svg>
              ) : (
                <svg viewBox="0 0 160 160" focusable="false">
                  <rect class="pb-paint-frame" x="18" y="28" width="124" height="92" rx="4" />
                  <rect class="pb-paint-fill pb-paint-fill--1" x="26" y="36" width="54" height="34" rx="2" />
                  <rect class="pb-paint-fill pb-paint-fill--2" x="86" y="36" width="48" height="34" rx="2" />
                  <rect class="pb-paint-fill pb-paint-fill--3" x="26" y="76" width="108" height="36" rx="2" />
                </svg>
              )}
            </div>
          </a>
        ))}
      </section>

      <section class="pb-how-it-works" aria-labelledby="how-title">
        <p class="pb-kicker">how it works / 怎么配合</p>
        <h2 id="how-title">AI 是搭档，不是代写。</h2>
        <div class="pb-how-grid">
          <article>
            <span>01</span>
            <h3>你决定故事</h3>
            <p>主角是谁、最想讲什么、故事怎么发展、最后怎么结束，都由你说。网站帮你准备采访提示词和故事创意卡模板；真正一次一个问题的采访，由课堂智能体完成。</p>
          </article>
          <article>
            <span>02</span>
            <h3>你决定画面</h3>
            <p>每页写清画面、动作、情绪。课堂智能体负责生成提示词和图片；保留哪一版、要不要重做，仍然由你决定。</p>
          </article>
          <article>
            <span>03</span>
            <h3>你带走作品</h3>
            <p>保存 v1 和 v2 工程文件，就是留下两条时间线。旧版不是废稿，是你可以随时回去看的“反悔按钮”。</p>
          </article>
        </div>
      </section>
    </main>

    <footer class="project-page-footer">
      <p>MakerX AI 造物实验室</p>
      <a href={baseUrl}>回到首页 ↗</a>
    </footer>
  </div>
</BaseLayout>
