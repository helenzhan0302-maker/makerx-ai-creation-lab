---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoryCardBuilder from '../../../components/StoryCardBuilder.astro';
import ProjectFileBar from '../../../components/ProjectFileBar.astro';
import '../../../styles/ai-planet-builder.css';
import '../../../styles/planet-upgrade.css';
import '../../../styles/picturebook.css';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="故事造物机 · 第 1 节课｜MakerX AI 造物实验室" description="从一个灵感出发，让 AI 一次问一个问题，帮你想清楚故事，最后生成并保存自己的完整故事。">
  <div class="project-page-shell pb-page-shell">
    <header class="project-page-header">
      <a class="project-back-link" href={`${baseUrl}lab/002-picturebook/`}>← 故事造物机课程总览</a>
      <span class="project-page-status">实验编号 002 / 故事造物机 · 第 1 节课</span>
    </header>

    <main id="main-content">
      <section class="project-intro pb-intro" aria-labelledby="project-title">
        <p class="eyebrow">project 002 / story director camp</p>
        <h1 id="project-title">故事造物机</h1>
        <p class="project-intro-lead">今天，你就是故事导演！从一个小小的想法出发，创造一个真正属于自己的故事。你负责想象和决定，AI 是你的创作搭档。</p>
        <p class="project-intro-notes">
          <a class="lesson-next-link" href={`${baseUrl}lab/002-picturebook/lesson-2/`}>下周六带着故事文件回来：进入绘本造物营 ↗</a>
        </p>
      </section>

      <StoryCardBuilder />

      <section class="pb-section pb-save-panel" aria-labelledby="lesson-one-save">
        <div class="pb-section-heading">
          <p class="pb-kicker">save story / 带走原创故事</p>
          <h2 id="lesson-one-save">故事确认好了，就把它带回家。</h2>
          <p>保存下来的文件就是下周六的入口。第 1 节结束时带走 <code>story-project-v1.json</code>，下周用它继续制作绘本。</p>
        </div>
        <ProjectFileBar
          mode="export"
          baseVersion={1}
          title="保存我的故事档案"
          requireStory={true}
        />
      </section>
    </main>

    <footer class="project-page-footer">
      <p>MakerX AI 造物实验室</p>
      <a href={baseUrl}>回到首页 ↗</a>
    </footer>
  </div>
</BaseLayout>
