---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlanetUpgradeBuilder from '../../../components/PlanetUpgradeBuilder.astro';
import '../../../styles/ai-planet-builder.css';
import '../../../styles/planet-upgrade.css';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="第 2 节课 · AI星球升级工坊｜MakerX AI 造物实验室" description="把第 1 节课做好的 AI星球升级成 2.0：头像、鼠标特效和屏幕宠物，一步一步生成中文提示词。">
  <div class="project-page-shell">
    <header class="project-page-header">
      <a class="project-back-link" href={`${baseUrl}lab/001-ai-planet/`}>← 回到第 1 节课</a>
      <span class="project-page-status">实验编号 001 / 第 2 节课</span>
    </header>

    <main id="main-content">
      <section class="project-intro" aria-labelledby="project-title">
        <p class="eyebrow">project 001 / lesson 02</p>
        <h1 id="project-title">AI星球升级工坊</h1>
        <p class="project-intro-lead">把你的网站从 1.0 升级到 2.0。选好效果，复制一段提示词，回到上次做网站的那个对话继续改。</p>
        <div class="project-intro-notes">
          <p>选做，不用打字</p>
          <p>不填写姓名</p>
          <p>不上传内容</p>
          <p>刷新后重新开始</p>
        </div>
      </section>

      <PlanetUpgradeBuilder />
    </main>

    <footer class="project-page-footer">
      <p>MakerX AI 造物实验室</p>
      <a href={baseUrl}>回到首页 ↗</a>
    </footer>
  </div>
</BaseLayout>
